<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Camada 1: Corpo do Vidro (Muitíssimo transparente para máxima nitidez) -->
    <item android:id="@+id/glass_base">
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <!-- Camada 2: Brilho Especular (Rim Light) mais nítido -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:startColor="#B3FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="sweep"
                android:centerY="0.65"
                android:centerX="1.15"/>
        </shape>
    </item>

    <!-- Camada 3: Borda Polida (Brilho de contorno) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke
                android:width="1dp"
                android:color="#80FFFFFF" />
        </shape>
    </item>
</layer-list>