<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E1E1E"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="#33FFFFFF" />

    <TextView
        android:id="@+id/tv_sheet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Novo Bloco"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_fixed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="Fixa (Semanal)"
            android:textColor="#FFFFFF" />

        <RadioButton
            android:id="@+id/rb_punctual"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pontual"
            android:textColor="#FFFFFF" />
    </RadioGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:boxBackgroundColor="#2C2C2C"
        app:boxCornerRadiusBottomEnd="24dp"
        app:boxCornerRadiusBottomStart="24dp"
        app:boxCornerRadiusTopEnd="24dp"
        app:boxCornerRadiusTopStart="24dp"
        app:boxStrokeWidth="0dp"
        app:hintTextColor="#B0B0B0">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome da Atividade"
            android:textColor="#FFFFFF" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_start_time"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Início: 08:00"
            app:cornerRadius="24dp" />

        <Button
            android:id="@+id/btn_end_time"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Fim: 10:00"
            app:cornerRadius="24dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_date"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Data: 2023-10-27"
        android:visibility="gone"
        app:cornerRadius="24dp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cg_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_dom"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="D"
            android:textColor="#FFFFFF" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_seg"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S"
            android:textColor="#FFFFFF" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_ter"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="T"
            android:textColor="#FFFFFF" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_qua"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Q"
            android:textColor="#FFFFFF" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_qui"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Q"
            android:textColor="#FFFFFF" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sex"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S"
            android:textColor="#FFFFFF" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sab"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S"
            android:textColor="#FFFFFF" />
    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:boxBackgroundColor="#2C2C2C"
        app:boxCornerRadiusBottomEnd="24dp"
        app:boxCornerRadiusBottomStart="24dp"
        app:boxCornerRadiusTopEnd="24dp"
        app:boxCornerRadiusTopStart="24dp"
        app:boxStrokeWidth="0dp"
        app:hintTextColor="#B0B0B0">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_tasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Tarefas (uma por linha)"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:textColor="#FFFFFF" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cor da Atividade"
        android:textColor="#B0B0B0"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:scrollbars="none">

        <RadioGroup
            android:id="@+id/rg_color_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- 1. Vermelho -->
            <RadioButton
                android:id="@+id/color_red"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:button="@null"
                android:background="@drawable/selector_color_dot"
                android:backgroundTint="#FF0000"
                android:foreground="@drawable/selection_border" />

            <!-- 2. Laranja -->
            <RadioButton
                android:id="@+id/color_orange"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:button="@null"
                android:background="@drawable/selector_color_dot"
                android:backgroundTint="#FF7F00"
                android:foreground="@drawable/selection_border" />

            <!-- 3. Amarelo -->
            <RadioButton
                android:id="@+id/color_yellow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:button="@null"
                android:background="@drawable/selector_color_dot"
                android:backgroundTint="#FFFF00"
                android:foreground="@drawable/selection_border" />

            <!-- 4. Lima -->
            <RadioButton
                android:id="@+id/color_lime"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:button="@null"
                android:background="@drawable/selector_color_dot"
                android:backgroundTint="#7FFF00"
                android:foreground="@drawable/selection_border" />

            <!-- 5. Verde -->
            <RadioButton
                android:id="@+id/color_green"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:button="@null"
                android:background="@drawable/selector_color_dot"
                android:backgroundTint="#00FF00"
                android:foreground="@drawable/selection_border" />

            <!-- 6. Verde-água -->
            <RadioButton
                android:id="@+id/color_spring_green"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:button="@null"
                android:background="@drawable/selector_color_dot"
                android:backgroundTint="#00FF7F"
                android:foreground="@drawable/selection_border" />

            <!-- 7. Ciano -->
            <RadioButton
                android:id="@+id/color_cyan"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:button="@null"
                android:background="@drawable/selector_color_dot"
                android:backgroundTint="#00FFFF"
                android:foreground="@drawable/selection_border" />

            <!-- 8. Azul Claro -->
            <RadioButton
                android:id="@+id/color_azure"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:button="@null"
                android:background="@drawable/selector_color_dot"
                android:backgroundTint="#007FFF"
                android:foreground="@drawable/selection_border" />

            <!-- 9. Azul -->
            <RadioButton
                android:id="@+id/color_blue"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:button="@null"
                android:background="@drawable/selector_color_dot"
                android:backgroundTint="#0000FF"
                android:foreground="@drawable/selection_border" />

            <!-- 10. Roxo -->
            <RadioButton
                android:id="@+id/color_violet"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:button="@null"
                android:background="@drawable/selector_color_dot"
                android:backgroundTint="#7F00FF"
                android:foreground="@drawable/selection_border" />

            <!-- 11. Magenta -->
            <RadioButton
                android:id="@+id/color_magenta"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:button="@null"
                android:background="@drawable/selector_color_dot"
                android:backgroundTint="#FF00FF"
                android:foreground="@drawable/selection_border" />

            <!-- 12. Rosa -->
            <RadioButton
                android:id="@+id/color_rose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:button="@null"
                android:background="@drawable/selector_color_dot"
                android:backgroundTint="#FF007F"
                android:foreground="@drawable/selection_border" />

        </RadioGroup>
    </HorizontalScrollView>

    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:backgroundTint="#FFFFFF"
        android:text="Salvar Bloco"
        android:textColor="#121212"
        android:textStyle="bold"
        app:cornerRadius="32dp" />

</LinearLayout>
